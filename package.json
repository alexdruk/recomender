{
  "name": "recomender",
  "version": "0.1.0",
  "private": true,
  "description": "Personal book recommender - downloads the daily Flibusta update files, scores the new books by their text, and shows ranked recommendations on a local page",
  "type": "commonjs",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "all": "node src/run-all.js",
    "unzip": "node src/unzip.js",
    "parse-fb2": "node src/parse-fb2.js",
    "parse-epub": "node src/parse-epub.js",
    "dedupe": "node src/dedupe.js",
    "inventory": "node src/inventory.js",
    "probe-feed": "node src/probe-feed.js",
    "catalog": "node src/fetch-catalog.js",
    "feed": "node src/fetch-feed.js",
    "genre-map": "node src/build-genre-map.js",
    "enrich": "node src/enrich.js",
    "baseline": ".venv/bin/python model/baseline.py",
    "fetch-books": "node src/fetch-books.js",
    "stylometry": "node src/stylometry.js",
    "embed": ".venv/bin/python model/embed.py",
    "fingerprints": "node src/fetch-books.js && node src/stylometry.js && .venv/bin/python model/embed.py && .venv/bin/python model/fingerprints.py",
    "fingerprints-report": ".venv/bin/python model/fingerprints.py",
    "index": "node src/build-index.js",
    "funnel": "node src/fetch-books.js --read && node src/build-index.js && node src/stylometry.js && .venv/bin/python model/embed.py && .venv/bin/python model/funnel.py",
    "funnel-report": "node src/build-index.js && .venv/bin/python model/funnel.py",
    "train": ".venv/bin/python model/recommend.py train",
    "daily": "node src/daily.js",
    "start": "node src/server.js",
    "autostart-on": "node src/autostart.js on",
    "autostart-off": "node src/autostart.js off",
    "check-page": "node src/check-page.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "express": "^5.3.0",
    "htmlparser2": "^12.0.0",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "acorn": "^8.19.0"
  }
}
