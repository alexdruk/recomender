{
  "dataDir": "data",
  "mirrors": [
    "https://flibusta.is",
    "https://flibusta.site"
  ],
  "pauseSeconds": 3,
  "deleteZipAfterParse": true,
  "catalogTables": [
    "libbook",
    "libavtor",
    "libavtorname",
    "libtranslator",
    "libgenre",
    "libgenrelist",
    "libseq",
    "libseqname",
    "libjoinedbooks",
    "librate",
    "reviews"
  ],
  "port": 3000,
  "host": "0.0.0.0",
  "checkEveryHours": 6,
  "topPercent": 5,
  "restDays": 7,
  "retrainEveryAnswers": 10,
  "ratingsEveryHours": 24,
  "rescoreDays": 60,
  "cleanup": {
    "feedTextDays": 14,
    "epubDays": 30
  },
  "filters": {
    "russianOnly": true,
    "fictionOnly": true,
    "skipCollections": true,
    "minWords": 10000,
    "skipLibraryBooks": true,
    "seriesRule": true
  },
  "reader": {
    "ollama": "http://127.0.0.1:11434",
    "model": "qwen3.5:9b",
    "openingWords": 25000,
    "partWords": 8400,
    "readWords": 2500,
    "contextTokens": 10240,
    "dailyBooks": 30,
    "dropFactors": [
      "pace",
      "explicit",
      "tone_tense",
      "tone_lyrical",
      "tone_dark",
      "tone_dry"
    ]
  }
}
