{
  "dataDir": "data",
  "mirrors": [
    "https://flibusta.is",
    "https://flibusta.site"
  ],
  "pauseSeconds": 3,
  "deleteZipAfterParse": true,
  "catalogTables": [
    "libbook",
    "libavtor",
    "libavtorname",
    "libtranslator",
    "libgenre",
    "libgenrelist",
    "libseq",
    "libseqname",
    "libjoinedbooks",
    "librate",
    "reviews"
  ],
  "port": 3000,
  "host": "0.0.0.0",
  "checkEveryHours": 6,
  "topPercent": 5,
  "restDays": 7,
  "retrainEveryAnswers": 10,
  "filters": {
    "russianOnly": true,
    "fictionOnly": true,
    "skipCollections": true,
    "minWords": 10000,
    "skipLibraryBooks": true,
    "seriesRule": true
  }
}
